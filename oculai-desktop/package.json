{
  "name": "oculai-desktop",
  "version": "0.0.4",
  "description": "Oculai Talent Sourcing Desktop - Multi-Agent Talent Sourcing System",
  "main": "dist/main/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "npm run generate-tools && npm run verify-runtime && tsc -p tsconfig.main.json && vite build && electron-builder",
    "build:ci": "tsc -p tsconfig.main.json && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit:ci": "node scripts/check-audit.mjs --omit=dev && node scripts/check-audit.mjs",
    "generate-tools": "python ../scripts/generate_pi_tools.py",
    "verify-runtime": "python ../scripts/verify_runtime_bundle.py --root resources/runtime"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.80.9",
    "@earendil-works/pi-coding-agent": "0.80.9",
    "@sinclair/typebox": "^0.32.0",
    "electron-store": "^10.0.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.0",
    "tailwindcss": "^3.4.6",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "6.0.3",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "postcss": "^8.4.39",
    "typescript": "^5.5.0",
    "vite": "8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "protobufjs": "7.6.5",
    "brace-expansion": "5.0.8"
  }
}
